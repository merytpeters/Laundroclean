generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ENUMS

enum UserType {
  COMPANYUSER
  CLIENT
}

enum TokenType {
  ACCESS
  REFRESH
  RESET
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

enum Currency {
  DOLLAR
  NAIRA
  POUNDS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS                             @map("IN PROGRESS")
  COMPLETED
  CANCELLED
  IN_TRANSIT                              @map("IN TRANSIT")
  DELIVERED

  CUSTOMER_DROPPED_OFF_AT_POINT           @map("CUSTOMER DROPPED OFF AT POINT")
  CUSTOMER_PICKED_UP_FROM_POINT           @map("CUSTOMER PICKED UP FROM POINT")

  COMPANY_PICKED_UP_FROM_CUSTOMER         @map("COMPANY PICKED UP FROM CUSTOMER")
  COMPANY_PICKED_UP_FROM_POINT            @map("COMPANY PICKED UP FROM POINT")
  COMPANY_DROPPED_OFF_AT_POINT            @map("COMPANY DROPPED OFF AT POINT")
}

enum DeliveryType {
  DROP_OFF  @map("DROP OFF")
  PICK_UP   @map("PICK UP")
}

enum PricingType {
  PER_KG        @map("PER KG")
  PER_ITEM      @map("PER ITEM")
  FLAT_RATE     @map("FLAT RATE")
}

enum PaymentProvider {
  PAYSTACK
  OPAY
  INTERNAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REVERSED
  EXPIRED
  ABANDONED
  REFUNDED
}


// MODELS


model CompanyRoleTitle {
  id              Int      @id @default(autoincrement())
  title           String   @unique
  level           Int?
  permissions     String[] @default([])
  users           User[]

  @@map("companyRoleTitle")
}

model User {
  id                  String              @id @default(uuid())
  firstName           String?             @map("first_name")
  lastName            String?             @map("last_name")
  email               String              @unique
  password            String
  type                UserType
  roleId              Int?
  role                CompanyRoleTitle?   @relation(fields: [roleId], references: [id])
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  isActive            Boolean             @default(true)

  tokens              Token[]
  profile             Profile?
  notifications       Notification[]
  assignedBookings    Booking[]           @relation("AssignedBookings")
  staffCalendar       StaffCalendar[]
  promoUsages         PromoUsage[]

  @@map("users")
}

model Token {
  id         String     @id @default(uuid())
  token      String     @unique
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       TokenType
  expiresAt  DateTime   @map("expires_at")
  valid      Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("tokens")
}

model Profile {
  id                  String     @id @default(uuid())
  userId              String     @unique @map("user_id")
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isTemp              Boolean    @default(false)
  avatarUrl           String?    @map("avatar_url")
  avatarPublicId      String?    @map("avatar_public_id")
  phoneNumber         String?    @map("phone_number")
  addressLine1        String?    @map("address_line_1")
  addressLine2        String?    @map("address_line_2")
  city                String?
  state               String?
  postalCode          String?    @map("postal_code")
  paymentMethodToken  String?    @map("payment_method_token")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  bookings            Booking[]  @relation("BookingProfile")
  addressBookings     Booking[]  @relation("BookingAddress")

  @@map("profiles")
}

model Notification {
  id                   String                  @id @default(uuid())
  userId               String?                 @map("user_id")
  user                 User?                   @relation(fields: [userId], references: [id])
  types                NotificationType[]
  title                String?
  message              String
  status               NotificationStatus
  sentAt               DateTime?               @map("sent_at")
  priority             NotificationPriority

  bookingNotifications BookingNotifications[]

  @@map("notifications")
}

model Service {
  id                    String           @id @default(uuid())
  name                  String
  description           String
  maxDailyBookings      Int?             @map("max_daily_bookings")
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")

  bookings              Booking[]
  prices                ServicePrice[]

  // One optional promo code may be tied to a service
  promoCodes            PromoCode[]

  @@map("services")
}

model ServicePrice {
  id            String        @id @default(uuid())
  serviceId     String        @map("service_id")
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  amount        Decimal
  currency      Currency
  pricingType   PricingType   @map("pricing_type")

  isActive      Boolean       @default(true) @map("is_active")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([serviceId, isActive])
  @@map("service prices")
}

model ServiceArea {
  id            String             @id  @default(uuid())
  name          String             @unique
  isActive      Boolean            @default(true)
  latMin        Float?
  latMax        Float?
  lngMin        Float?
  lngMax        Float?

  @@map("service areas")
}


model DropOffPoint {
  id            String              @id @default(uuid())
  name          String              @unique
  address       String
  lat           Float?
  lng           Float?
  isActive      Boolean             @default(true)

  @@map("dropoff points")
}



model Booking {
  id                String           @id @default(uuid())
  profileId         String           @map("profile_id")
  profile           Profile          @relation("BookingProfile", fields: [profileId], references: [id])
  customBookingId   String           @unique @map("custom_booking_id")

  serviceId         String           @map("service_id")
  service           Service          @relation(fields: [serviceId], references: [id])

  unitPrice         Decimal          @map("unit_price")
  currency          Currency
  pricingType       PricingType      @map("pricing_type")
  totalAmount       Decimal          @map("total_amount")

  status            BookingStatus

  deliveryType      DeliveryType     @map("delivery_type")
  scheduledDate     DateTime?        @map("scheduled_date")
  pickupTime        DateTime?        @map("pickup_time")

  weight            Float?
  itemCount         Int?             @map("item_count")

  addressId         String?          @map("address_id")
  address           Profile?         @relation("BookingAddress", fields: [addressId], references: [id])
  additionalNote    String?          @map("additional_note")

  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  isActive          Boolean          @default(true)

  assignedToId      String?
  assignedTo        User?            @relation("AssignedBookings", fields: [assignedToId], references: [id])

  timeSlotId        String?
  timeSlot          TimeSlot?        @relation("TimeSlotBookings", fields: [timeSlotId], references: [id])

  

  // Promo fields: record applied promo immutably at booking time
  promoCodeId       String?          @map("promo_code_id")
  promoCode         PromoCode?       @relation(fields: [promoCodeId], references: [id])
  discountAmount    Decimal?         @map("discount_amount")
  finalAmount       Decimal?         @map("final_amount")
  bookingNotifications          BookingNotifications[]
  Transaction                   Transaction[]

  @@map("bookings")
}

model BookingSettings {
  id                     Int          @id @default(autoincrement())
  minPickupDays          Int          @default(3)
  updatedAt              DateTime     @updatedAt

  @@map("booking settings")
}

model StaffCalendar {
  id                    String          @id @default(uuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id])

  date                  DateTime
  notes                 String?
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  timeSlots             TimeSlot[]

  @@map("staff calendar")
}

model TimeSlot {
  id                    String              @id @default(uuid())
  staffCalendarId       String
  staffCalendar         StaffCalendar       @relation(fields: [staffCalendarId], references: [id])
  startTime             DateTime
  endTime               DateTime
  notes                 String?
  maxBookings           Int                 @default(5)
  bookings              Booking[]           @relation("TimeSlotBookings")

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("timeslots")
}


model BookingNotifications {
  bookingId      String @map("booking_id")
  booking        Booking @relation(fields: [bookingId], references: [id])
  notificationId String @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id])

  @@map("booking notifications")
  @@id([bookingId, notificationId])
}


enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCode {
  id                      String          @id @default(uuid())
  code                    String          @unique
  description             String?
  serviceId               String
  service                 Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings                Booking[]
  type                    PromoType
  value                   Decimal
  currency                Currency?
  isActive                Boolean         @default(true)
  startsAt                DateTime?
  expiresAt               DateTime?
  usageLimit              Int?
  perUserLimit            Int?
  timesUsed               Int             @default(0)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime?
  promoUsages             PromoUsage[]

  @@map("promo codes")
}

model PromoUsage {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  timesUsed   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("promo usages")
  @@index([userId, promoCodeId])
}

// Financial models

model Transaction {
  id                      String                  @id @default(uuid())

  bookingId               String
  userId                  String

  booking                 Booking                 @relation(fields: [bookingId], references: [id])

  paidAmount              Int
  platformFee             Int                     @default(0)
  merchantAmount          Int                     @default(0)

  currency                Currency                @default(NAIRA)

  status                  TransactionStatus       @default(PENDING)

  paidAt                  DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  transactionRef          String                  @unique

  payment                 Payment[]
  // refunds                 Refund[]
  // disputes                Dispute[]

  @@map("transactions")
}

model Payment {
  id                            String                  @id @default(uuid())
  transactionId                 String
  transaction                   Transaction             @relation(fields: [transactionId], references: [id])

  provider                      PaymentProvider
  providerRef                   String?                  @unique

  status                        PaymentStatus           @default(INITIATED)

  amount                        Int
  channel                       String?

  authorization                 Json?
  currency                      Currency                @default(NAIRA)

  initiatedAt                   DateTime                @default(now())
  paidAt                        DateTime?

  updatedAt                     DateTime                @updatedAt
  events                        PaymentEvent[]

  @@map("payments")
}


model PaymentEvent {
  id                            String                  @id @default(uuid())

  paymentId                     String?
  payment                       Payment?                @relation(fields: [paymentId], references: [id])

  provider                      PaymentProvider

  eventType                     String
  providerRef                   String?

  payload                       Json

  signature                     String?
  processed                     Boolean                 @default(false)
  createdAt                     DateTime                @default(now())

  @@map("payment events")
  @@unique([providerRef, eventType])
}

model PosDevice {
  id                            String                  @id @default(uuid())
  serialNumber                  String                  @unique
  name                          String?
  isActive                      Boolean                 @default(true)

  @@map("pos devices")
}


